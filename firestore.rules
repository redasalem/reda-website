rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only Reda Salem's verified Google account can create, update, or delete any portfolio data
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "redasalem287@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skillCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Strictly deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
